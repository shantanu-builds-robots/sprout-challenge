<mujoco model="sprout">
  <!-- Sprout, from the sprout-gym project (MIT).
       Same bodies, joints, masses, inertias and 150 N*m position servos; collisions are primitives (torso box,
       leg capsules, foot spheres). Collision bits: floor contype 1; torso box and leg parts touching the floor
       (*_col, feet) contype 0 / conaffinity 1; leg-vs-body: "torso_body" box contype 2 / conaffinity 0,
       leg and shin shapes (*_body) contype 0 / conaffinity 2, with a 1 cm margin; they leave out each part's
       joint housing. Legs never collide with each other. -->
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>
  <option timestep="0.005" iterations="10" ls_iterations="20">
    <flag eulerdamp="disable"/>
  </option>

  <default>
    <default class="sprout">
      <joint axis="0 1 0" frictionloss="0.1" armature="0.1"/>
      <position kp="200" inheritrange="1" dampratio="0.95" forcerange="-150 150"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" density="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3" contype="0" conaffinity="1" density="0" friction="0.8 0.02 0.01"/>
        <default class="foot">
          <geom type="sphere" size="0.03" priority="1" condim="3" solref="0.01 1"/>
        </default>
      </default>
      <default class="selfcol">
        <geom group="4" contype="0" conaffinity="2" density="0"/>
      </default>
    </default>
  </default>

  <asset>
    <mesh name="body" file="body.STL"/>
    <mesh name="camera" file="camera.STL"/>
    <mesh name="back_right_thigh" file="back_right_thigh.STL"/>
    <mesh name="back_right_leg" file="back_right_leg.STL"/>
    <mesh name="back_right_shin" file="back_right_shin.STL"/>
    <mesh name="back_left_thigh" file="back_left_thigh.STL"/>
    <mesh name="back_left_leg" file="back_left_leg.STL"/>
    <mesh name="back_left_shin" file="back_left_shin.STL"/>
    <mesh name="front_left_thigh" file="front_left_thigh.STL"/>
    <mesh name="front_left_leg" file="front_left_leg.STL"/>
    <mesh name="front_left_shin" file="front_left_shin.STL"/>
    <mesh name="front_right_thigh" file="front_right_thigh.STL"/>
    <mesh name="front_right_leg" file="front_right_leg.STL"/>
    <mesh name="front_right_shin" file="front_right_shin.STL"/>
  </asset>

